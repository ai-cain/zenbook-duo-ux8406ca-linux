#!/bin/bash
# Follow the UX8406CA posture with the accelerometer in the upper (eDP-1) lid.
#   upright      -> stacked: eDP-1 above eDP-2
#   upside down  -> stacked, both rotated 180 degrees, eDP-2 above eDP-1
#   on its side  -> desktop/book mode: both panels rotated, side by side
#   flat, ~180   -> share mode: upper panel rotated 180 degrees for the person opposite
# With the keyboard docked on the lower panel, ux8406ca-keyboard-dock owns the
# layout and this script stays out of the way.

set -u

# IIO device numbers change between boots; look the sensors up by name.
iio_device() {
  local dev
  for dev in /sys/bus/iio/devices/iio:device*; do
    [[ "$(<"$dev/name")" == "$1" ]] 2>/dev/null && { echo "$dev"; return 0; }
  done
  return 1
}

readonly accel_dir="${UX8406CA_ACCEL_DIR:-$(iio_device accel_3d)}"
readonly keyboard_vendor="0b05"
readonly keyboard_product="1bf2"
readonly upper="eDP-1"
readonly lower="eDP-2"
# Hyprland transforms used when gravity points along +x / -x of the sensor.
readonly transform_x_pos="${UX8406CA_TRANSFORM_X_POS:-1}"
readonly transform_x_neg="${UX8406CA_TRANSFORM_X_NEG:-3}"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
readonly lock_file="$runtime_dir/ux8406ca-rotation.lock"

log() { printf 'ux8406ca-rotation: %s\n' "$*"; }

keyboard_is_docked() {
  local device
  for device in /sys/bus/usb/devices/*; do
    [[ -r "$device/idVendor" && -r "$device/idProduct" ]] || continue
    [[ "$(<"$device/idVendor")" == "$keyboard_vendor" &&
       "$(<"$device/idProduct")" == "$keyboard_product" ]] && return 0
  done
  return 1
}

readonly hinge_file="${UX8406CA_HINGE_FILE:-$(iio_device hinge)/in_angl0_raw}"

# Print normal|inverted|side-pos|side-neg|shared|unknown from raw readings.
read_posture() {
  local x y z ax ay az hinge threshold
  x="$(<"$accel_dir/in_accel_x_raw")" || return 1
  y="$(<"$accel_dir/in_accel_y_raw")" || return 1
  z="$(<"$accel_dir/in_accel_z_raw")" || return 1
  ax=${x#-}; ay=${y#-}; az=${z#-}
  hinge=0; [[ -r "$hinge_file" ]] && hinge="$(<"$hinge_file")"
  # Raw units are ~1e-5 g; 0.6 g keeps the posture stable while the lid is tilted.
  threshold=600000
  if (( az > ax && az > ay && az > 800000 && hinge >= 160 && hinge <= 200 )); then
    # Opened flat on a table: share mode, the upper panel faces the other person.
    echo shared
  elif (( ay > ax && ay > threshold )); then
    (( y < 0 )) && echo normal || echo inverted
  elif (( ax > ay && ax > threshold )); then
    (( x > 0 )) && echo side-pos || echo side-neg
  else
    echo unknown
  fi
}

monitor_rule() {
  local output="$1" position="$2" transform="$3"
  printf 'hl.monitor({ output = "%s", mode = "preferred", position = "%s", scale = "auto", transform = %s })' \
    "$output" "$position" "$transform"
}

# Touch and stylus input do not follow the monitor transform on their own.
map_input() {
  local output="$1" transform="$2" device
  case "$output" in
    "$upper") set -- "elan9008:00-04f3:4445" "elan9008:00-04f3:4445-stylus" ;;
    "$lower") set -- "elan9009:00-04f3:4446" "elan9009:00-04f3:4446-stylus" ;;
  esac
  for device in "$@"; do
    hyprctl eval "hl.device({ name = \"$device\", output = \"$output\", transform = $transform })" >/dev/null
  done
}

apply_posture() {
  # first panel at 0x0, second placed relative to it; each with its own transform.
  local first second t_first t_second pos
  case "$1" in
    normal) first="$upper"; second="$lower"; t_first=0; t_second=0; pos="auto-down" ;;
    inverted) first="$lower"; second="$upper"; t_first=2; t_second=2; pos="auto-down" ;;
    side-pos) first="$lower"; second="$upper"; t_first="$transform_x_pos"; t_second="$transform_x_pos"; pos="auto-right" ;;
    side-neg) first="$upper"; second="$lower"; t_first="$transform_x_neg"; t_second="$transform_x_neg"; pos="auto-right" ;;
    shared) first="$upper"; second="$lower"; t_first=2; t_second=0; pos="auto-down" ;;
    *) return 0 ;;
  esac
  hyprctl eval "$(monitor_rule "$first" 0x0 "$t_first")" >/dev/null &&
    hyprctl eval "$(monitor_rule "$second" "$pos" "$t_second")" >/dev/null || return 1
  map_input "$first" "$t_first"
  map_input "$second" "$t_second"
  log "applied $1"
}

# Current transform and position of both panels, to detect when something else
# (a config reload, the dock script) resets the layout behind our back.
layout_signature() {
  hyprctl monitors 2>/dev/null |
    awk '/^Monitor/ {name=$2} / at / {pos=$NF} /transform:/ {print name, $2, pos}' |
    tr '\n' ' '
}

case "${1:-}" in
  --status) read_posture; exit ;;
  "") ;;
  *) printf 'Usage: %s [--status]\n' "${0##*/}" >&2; exit 2 ;;
esac

[[ -r "$accel_dir/in_accel_x_raw" ]] || { log "accelerometer not found at $accel_dir"; exit 1; }

exec 9>"$lock_file"
flock -n 9 || { log "another instance is already running"; exit 0; }

applied="normal"
applied_layout=""
candidate=""
count=0
while true; do
  sleep 0.5
  if keyboard_is_docked; then
    # The dock script only disables the lower panel; undo any rotation of the
    # upper one so the docked laptop is always in its normal posture.
    if [[ "$applied" != docked ]]; then
      hyprctl eval "$(monitor_rule "$upper" 0x0 0)" >/dev/null &&
        map_input "$upper" 0 && log "applied docked" && applied="docked"
    fi
    applied_layout=""; candidate=""; count=0
    continue
  fi
  posture="$(read_posture)" || continue
  [[ "$posture" == unknown ]] && { count=0; continue; }
  if [[ "$posture" == "$applied" ]]; then
    count=0
    # Reapply if the layout was reset while the posture did not change.
    if [[ -n "$applied_layout" && "$(layout_signature)" != "$applied_layout" ]]; then
      apply_posture "$posture" && applied_layout="$(layout_signature)"
    fi
    continue
  fi
  if [[ "$posture" == "$candidate" ]]; then
    (( count++ ))
  else
    candidate="$posture"; count=1
  fi
  # Require ~1 s of stable readings before switching.
  if (( count >= 2 )); then
    apply_posture "$posture" && applied="$posture" && applied_layout="$(layout_signature)"
    count=0
  fi
done
